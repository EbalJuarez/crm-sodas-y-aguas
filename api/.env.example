# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.
PORT=3000

# Misma base que laravel/.env (DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_agua
DB_USERNAME=
DB_PASSWORD=

# Al menos 32 caracteres aleatorios
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen exacto de la SPA (nunca *)
CORS_ORIGIN=http://127.0.0.1:5500
